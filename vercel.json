{
  "functions": {
    "*.php": { "runtime": "vercel-php@0.7.3" },
    "admin/*.php": { "runtime": "vercel-php@0.7.3" }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "/admin/login", "dest": "/admin/login.php" },
    { "src": "/admin/dashboard", "dest": "/admin/dashboard.php" },
    { "src": "/admin/logout", "dest": "/admin/logout.php" },
    { "src": "/serve_image", "dest": "/serve_image.php" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
